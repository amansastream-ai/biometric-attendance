# Connexion PostgreSQL (Neon, Supabase, Postgres local...)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Secret utilisé pour signer les défis WebAuthn (obligatoire en production)
# Générer par exemple avec : openssl rand -base64 32
WEBAUTHN_SECRET=changez-cette-valeur-secrete

# Secret de la route /api/seed (réinitialisation des données de démonstration)
SEED_SECRET=changez-cette-valeur-secrete

# Durée de vie d'une session utilisateur, en heures (facultatif, 12 par défaut)
SESSION_TTL_HOURS=12

# Second facteur des rôles sensibles (administrateur, DRH) :
#   prompt  (défaut) : une clé enrôlée est exigée à la connexion ; un compte qui
#                      n'en a pas encore est signalé et invité à en enrôler une.
#   enforce          : un compte sensible sans clé n'obtient qu'une session
#                      restreinte, limitée à l'enrôlement de sa clé.
# À basculer sur « enforce » en production, une fois les clés enrôlées.
TWO_FACTOR_POLICY=prompt
